    "test:live": "node --test providers.live.cjs",
    "test:live:login": "node providers.live.cjs --login",
    "rebuild:upstream": "node scripts/rebuild-upstream.cjs",
    "test:frames": "node --test --test-concurrency=1 frame-rules.browser.cjs"
  },
